# Copy this file to .env for local development.
# Never commit the real .env file or cloud credentials.

APP_NAME=CloudSync API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cloudsync

# Authentication - replace this value with a long random secret for real deployments.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local file storage (current implementation)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# AWS S3 (reserved for the next storage phase; no credentials are needed yet)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
