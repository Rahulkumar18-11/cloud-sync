# Copy this file to .env for local development.
# Do not commit your real .env file or cloud credentials.

APP_NAME=CloudSync API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# These will be used when database/authentication phases are implemented.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cloudsync
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Add real cloud credentials only to your local .env file.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
