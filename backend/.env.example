# Copy this file to .env for local development.
# Do not commit your real .env file or cloud credentials.

APP_NAME=CloudSync API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# PostgreSQL and authentication
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cloudsync
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage: local is used until the S3 integration is implemented.
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Do not put AWS access keys in this file.
# Configure local credentials with the AWS CLI/profile, or use an IAM role in AWS.
