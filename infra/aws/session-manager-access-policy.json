{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartSessionsOnlyOnCloudSyncInstances",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "CloudSync"
        }
      }
    },
    {
      "Sid": "UseTheStandardShellSessionDocument",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ssm:us-east-1:*:document/SSM-SessionManagerRunShell"
    },
    {
      "Sid": "ManageOwnSession",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:us-east-1:*:session/*"
    },
    {
      "Sid": "ViewCloudSyncInstancesAndSessionStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
